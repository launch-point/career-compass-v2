# Career Compass v2 — Intake App environment variables
# Copy to .env.local and fill in real values. NEVER commit real secrets.
# With a /src directory, .env* files live in the PROJECT ROOT (intake-app/), not /src.
#
# Prefix rules (Next.js 16): only NEXT_PUBLIC_* vars are inlined into the browser
# bundle. Everything else is server-only (Route Handlers, Server Components, proxy.ts).

# --- Supabase (Postgres + magic-link Auth) ---------------------------------
# Project URL and anon (publishable) key are safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service-role key bypasses RLS — SERVER ONLY. Used by Route Handlers for the
# submit pipeline and admin actions. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- App URLs / iframe hosting ---------------------------------------------
# The intake app's own public URL — used to build the magic-link redirect target.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Mission Control origin allowed to embed this app in an iframe. Used in the CSP
# `frame-ancestors` rule (next.config.ts). Direct (top-level) visits are always
# allowed; this only restricts who may FRAME the app. Example prod value:
# https://app.launchpoint.co
MISSION_CONTROL_ORIGIN=http://localhost:4000

# --- Orchestrator webhook (fired after DB commit on submit) ----------------
# REUSE the existing secret from the old repo's .env.example — do not invent a
# new one. Used to HMAC-sign the webhook payload so the orchestrator can verify.
CAREER_COMPASS_WEBHOOK_SECRET=your-shared-webhook-secret
# Where the submit webhook is POSTed. Leave blank locally to skip the webhook
# side-effect (submission still succeeds; DB is the source of truth).
ORCHESTRATOR_WEBHOOK_URL=

# --- Google Sheets writeback (Intake Submissions tab) ----------------------
# Master Data Sheet ID (confirmed, from MEMORY.md).
MASTER_DATA_SHEET_ID=1hgBOWdDzMzEvun5Vv0CxU7AKRAToohgnSDABQ1jdMpg
# Service-account credentials for the Sheets append. SERVER ONLY.
# The private key must keep its literal \n newlines when pasted into one line.
GOOGLE_SERVICE_ACCOUNT_EMAIL=career-compass@your-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Admin access ----------------------------------------------------------
# Comma-separated allowlist of emails permitted to open the /admin view and
# unlock submissions. SERVER ONLY.
ADMIN_EMAILS=todd@launchpoint.co
